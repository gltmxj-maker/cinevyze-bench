          "배송",
          "교환",
          "상품문의",
          "기타"
        ]
      },
      "cases": [
        {
          "id": "C01",
          "attack": "none",
          "input": "결제한 주문을 취소하고 돈을 돌려받고 싶습니다.",
          "expected": {
            "id": "C01",
